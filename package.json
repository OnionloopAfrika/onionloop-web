{
  "name": "onion-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:landing": "pnpm --filter @onion/landing dev",
    "dev:crew": "pnpm --filter @onion/crew dev",
    "dev:mega": "pnpm --filter @onion/mega dev",
    "dev:aggregator": "pnpm --filter @onion/aggregator dev",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
